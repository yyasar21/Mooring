// markdownlint configuration for Mooring documentation.
// Prose wraps at 100 columns like rustfmt; tables, code blocks and headings may run longer.
{
  "default": true,
  "MD013": { "line_length": 100, "tables": false, "code_blocks": false, "headings": false },
  "MD024": { "siblings_only": true },
  "MD033": false
}
