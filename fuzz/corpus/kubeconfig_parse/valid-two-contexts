apiVersion: v1
kind: Config
current-context: lab
clusters:
- name: lab
  cluster:
    server: https://k8s.example.test:6443
    certificate-authority-data: AAAA
contexts:
- name: lab
  context:
    cluster: lab
    user: ops
- name: lab-admin
  context: {cluster: lab, user: ops, namespace: kube-system}
users:
- name: ops
  user:
    token: test-only-token
