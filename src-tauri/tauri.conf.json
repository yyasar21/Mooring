{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mooring Dev",
  "version": "0.1.2",
  "identifier": "io.github.yyasar21.mooring.dev",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @mooring/desktop dev",
    "beforeBuildCommand": "pnpm --filter @mooring/desktop build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Mooring Dev",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": ["main", "detached", "web", "oidc"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mooring Project",
    "copyright": "Copyright (c) 2026 Yunus Yasar. Released under the MIT License.",
    "license": "MIT",
    "licenseFile": "../packaging/LICENSE-installer.txt",
    "homepage": "https://github.com/yyasar21/Mooring",
    "category": "DeveloperTool",
    "shortDescription": "Security-first remote access manager",
    "longDescription": "Mooring keeps SSH, RDP and VNC connections, credentials and sessions in one place. Credentials live in a local Argon2id + XChaCha20-Poly1305 vault that never leaves the Rust core, and every action lands in a tamper-evident audit log. No telemetry.",
    "icon": ["icons-dev/32x32.png", "icons-dev/128x128.png", "icons-dev/128x128@2x.png", "icons-dev/icon.icns", "icons-dev/icon.ico"],
    "createUpdaterArtifacts": false,
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "../packaging/macos/entitlements.plist",
      "dmg": {
        "background": "../packaging/macos/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 170 },
        "applicationFolderPosition": { "x": 480, "y": 170 }
      }
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "wix": {
        "language": "en-US",
        "upgradeCode": "9eff6699-6217-579b-8071-28cf4e556939"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false,
        "installerIcon": "icons-dev/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "section": "net",
        "priority": "optional",
        "recommends": ["gnome-keyring"],
        "desktopTemplate": "../packaging/linux/mooring.desktop"
      },
      "rpm": {
        "release": "1",
        "recommends": ["gnome-keyring"],
        "desktopTemplate": "../packaging/linux/mooring.desktop"
      },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
