{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mooring",
  "version": "0.1.0",
  "identifier": "xyz.homelab.mooring",
  "build": {
    "frontendDist": "../apps/desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @mooring/desktop dev",
    "beforeBuildCommand": "pnpm --filter @mooring/desktop build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Mooring",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "freezePrototype": true,
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Security-first remote access manager",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0" },
    "windows": { "webviewInstallMode": { "type": "downloadBootstrapper" } },
    "createUpdaterArtifacts": false
  }
}
