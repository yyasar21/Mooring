{
  "name": "mooring-remote",
  "private": true,
  "version": "0.2.0-rc.3",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mooring/desktop dev",
    "build": "pnpm -r build",
