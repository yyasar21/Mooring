# Copy to .env (gitignored). Only used by the #[ignore]d lab tests; the app itself reads nothing from here.
# Real hosts, IPs, account names and domains never go in the repository: keep them in your local .env.
# Lab tests skip with a message when MOORING_LAB_HOST is unset.
MOORING_LAB_HOST=ssh.lab.example.test
MOORING_LAB_PORT=22
MOORING_LAB_USER=mooring-test
# Optional: known_hosts file the lab test reads (read-only). Default: ~/.ssh/known_hosts
# MOORING_LAB_KNOWN_HOSTS=
# passwords are never in files: tests use the ssh-agent or the OS keychain
MOORING_LOG=info
